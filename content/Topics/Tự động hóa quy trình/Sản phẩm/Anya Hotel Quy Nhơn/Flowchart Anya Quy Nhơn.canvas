		{"id":"process_4","type":"text","text":"**4. Tạo BEO (Banquet Event Order)**\n\n\"Dịch\" tất cả yêu cầu của khách hàng thành một tài liệu vận hành chi tiết.","x":400,"y":420,"width":300,"height":100,"color":"3"},
