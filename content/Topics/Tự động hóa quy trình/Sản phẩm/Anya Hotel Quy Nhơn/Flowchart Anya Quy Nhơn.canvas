		{"id":"pain_point_3","type":"text","text":"❗️**Nỗi đau:** Nhập liệu lặp lại (redundant). Thông tin trên CRM và PMS có thể không khớp nhau.","x":1080,"y":30,"width":300,"height":140,"color":"1"},
